import prisma from '../../common/prisma';
import { {{pascalCase name}}CreateInput, {{pascalCase name}}UpdateInput } from './{{dashCase name}}.type';
import { PaginationInput, buildPaginatedResponse } from '../../utils';

export const {{pascalCase name}}Repository = {
  async create(data: {{pascalCase name}}CreateInput) {
    return (prisma as any).{{camelCase name}}.create({ data });
